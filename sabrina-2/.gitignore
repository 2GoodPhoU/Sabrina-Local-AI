# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Environment / secrets
.env
.env.local
*.key

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Sabrina runtime
# `/data/` holds the local sqlite memory store (sabrina.db) at runtime,
# but also tracked data assets (e.g. `shortcuts.yaml`). Match files inside
# the directory (not the directory itself) so negation patterns can
# re-include specific tracked assets.
/data/*
!/data/*.yaml
!/data/*.yml
/logs/
*.db
*.sqlite
*.sqlite3

# uv (lockfile IS committed; cache/workspace dirs are not)
.uv_cache/

# Large downloadable assets (fetched by install-piper.ps1)
voices/
tools/
