# OS
.DS_Store
Thumbs.db

# Sabrina runtime
# `/data/` holds the local sqlite memory store (sabrina.db) at runtime,
# but also tracked data assets (e.g. `shortcuts.yaml`). Match files inside
# the directory (not the directory itself) so negation patterns can
# re-include specific tracked assets.
/data/*
!/data/*.yaml
!/data/*.yml
/logs/
*.db
*.sqlite
*.sqlite3

# uv (lockfile IS committed; cache/workspace dirs are not)
.uv_cache/

# Large downloadable assets (fetched by install-piper.ps1)
voices/
tools/piper/

# Wake-word training pipeline outputs — the tooling itself
# (`tools/wake-training/*.py` / `*.md` / `*.txt`) IS tracked; only the
# heavy synthesised positives, scratch, and pre-promotion artifacts are
# excluded. The promoted artifact at `models/openwakeword/hey_sabrina.onnx`
# is committed via a separate atomic commit (see P2.2).
tools/wake-training/data/
tools/wake-training/scratch/
tools/wake-training/output/
